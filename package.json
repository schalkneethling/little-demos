{
  "name": "little-demos",
  "version": "0.0.0",
  "description": "An explorable fairground for interactive web demos.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "assets:check": "bun scripts/assets/export-assets.ts --check",
    "assets:export": "bun scripts/assets/export-assets.ts",
    "build": "vp build",
    "dev": "vp dev",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "bash scripts/testing/playwright-docker.sh",
    "test:e2e:update": "bash scripts/testing/playwright-docker.sh --update-snapshots=changed",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "prepare": "vp config",
    "lint": "node .calavera/run-if-files.mjs \"JavaScript/TypeScript\" \"js,jsx,ts,tsx,mjs,cjs\" -- oxlint . && node .calavera/run-if-files.mjs \"CSS\" \"css,scss\" -- stylelint \"**/*.{css,scss}\"",
    "lint:fix": "node .calavera/run-if-files.mjs \"JavaScript/TypeScript\" \"js,jsx,ts,tsx,mjs,cjs\" -- oxlint --fix . && node .calavera/run-if-files.mjs \"CSS\" \"css,scss\" -- stylelint \"**/*.{css,scss}\" --fix",
    "format": "node .calavera/run-if-files.mjs \"JavaScript/TypeScript\" \"js,jsx,ts,tsx,mjs,cjs\" -- oxfmt --write .",
    "format:check": "node .calavera/run-if-files.mjs \"JavaScript/TypeScript\" \"js,jsx,ts,tsx,mjs,cjs\" -- oxfmt --check .",
    "typecheck": "node .calavera/run-if-files.mjs \"TypeScript\" \"ts,tsx\" -- tsc --noEmit",
    "typecheck:assets": "tsc --ignoreConfig --noEmit --module ESNext --moduleResolution bundler --target ESNext --strict --skipLibCheck --esModuleInterop scripts/assets/export-assets.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@schalkneethling/stylelint-plugin-css-property-type-validator": "0.1.0-beta.1",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-use-baseline": "^1.4.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "4.1.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
